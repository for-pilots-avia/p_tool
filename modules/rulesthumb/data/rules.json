  "categories": [
    {
      "id": "pressure-temp",
      "title": "Pressure & Temperature",
      "rules": [
        {
          "num": "1",
          "title": "Altimeter correction for non-standard pressure",
          "tip": "\"From high to low, look below\"",
          "formula": "1 mb = 30 ft\nCorrection = ΔPressure (mb) × 30 ft",
          "example": "FL 270, QNH 977 → ISA − 36 mb\n36 × 30 = 1 080 ft → True Alt = 25 920 ft",
          "calcId": "altPressure"
        },
        {
          "num": "2",
          "title": "Altimeter correction for non-standard temperature",
          "tip": "\"From high to low, look below\"",
          "formula": "Corr (ft) = 4 × ΔISA × Altitude (ft) / 1 000",
          "example": "FL 300, ISA − 6 °C\nCorr = 4 × 6 × 30 = 720 ft → True Alt = 29 280 ft",
          "calcId": "altTemp"
        },
        {
          "num": "3",
          "title": "SAT out of TAT (standard Mach)",
          "formula": "SAT (°C) = TAT (°C) − 3 × Mach",
          "example": "TAT = −17 °C, Mach 0.64\nSAT = −17 − (3 × 6) = −35 °C",
          "calcId": "satFromTat"
        },
        {
          "num": "4",
          "title": "SAT out of TAT (higher Mach, lower temp)",
          "formula": "SAT (°C) = TAT (°C) − (100 × Mach) − 50",
          "example": "TAT = −31 °C, Mach 0.74\n24 above M 0.50 → SAT = −31 − 24 = −55 °C",
          "calcId": "satFromTatHigh"
        }
      ]
    },
    {
      "id": "speeds",
      "title": "Speeds & Mach",
      "rules": [
        {
          "num": "9",
          "title": "TAS from Mach number (high altitude cruise)",
          "formula": "TAS (kt) = Mach digit × 60",
          "example": "M 0.72 → TAS = 7 × 60 = 420 kt",
          "calcId": "tasFromMach"
        },
        {
          "num": "10",
          "title": "TAS from IAS and Flight Level",
          "formula": "TAS (kt) = IAS (kt) + FL / 2",
          "example": "FL 300, IAS 240 kt → TAS = 240 + 150 = 390 kt",
          "calcId": "tasFromIas"
        },
        {
          "num": "11",
          "title": "Ground Speed from Mach",
          "formula": "GS (NM/min) = 10 × Mach",
          "example": "M 0.72 → GS = 7.2 NM/min",
          "calcId": "gsFromMach"
        },
        {
          "num": "14",
          "title": "Ground Speed with DME station",
          "formula": "GS (kt) = 10 × distance (NM) in 36 s",
          "example": "3.25 NM in 36 s → GS = 325 kt",
          "calcId": "gsFromDme"
        },
        {
          "num": "GEN",
          "title": "TAS from IAS and Altitude (precise)",
          "formula": "TAS = [(IAS × 2%) × (ALT / 1 000 ft)] + IAS",
          "example": "IAS 300 kt, ALT 20 000 ft\n300 × 0.02 × 20 + 300 = 420 KTAS",
          "calcId": "tasFromIasAlt"
        },
        {
          "num": "GEN",
          "title": "Kinetic Heating",
          "formula": "TAT increases by ~1 °C per 10 kt IAS"
        }
      ],
      "tables": [
        {
          "title": "Speed Number Reference (1/60 rule)",
          "headers": ["Speed (kt)", "120", "150", "180", "210", "240", "270", "300", "330"],
          "rows": [["Speed Number", "2", "2½", "3", "3½", "4", "4½", "5", "5½"]]
        }
      ]
    },
    {
      "id": "climb-descent",
      "title": "Climb, Descent & Vertical Speed",
      "rules": [
        {
          "num": "5",
          "title": "Level-off lead (R/C ≤ 1 000 ft/min)",
          "formula": "Δ ft = R/C (ft/min) / 10",
          "example": "Climbing to FL 210, R/C = 2 000 ft/min\nΔ = 200 ft → start level-off at 20 800 ft",
          "calcId": "levelOffLow"
        },
        {
          "num": "6",
          "title": "Level-off lead (R/C > 1 000 ft/min)",
          "formula": "Δ ft = 2 × R/C (ft/min) / 10",
          "example": "Climbing to FL 300, R/C = 2 500 ft/min\nΔ = 500 ft → start level-off at 29 500 ft",
          "calcId": "levelOffHigh"
        },
        {
          "num": "7",
          "title": "Cruise Flight Level computation",
          "formula": "Cruise FL ≈ Trip Distance (NM)",
          "example": "EBBR–EBOS = 60 NM → Optimum FL 60",
          "calcId": "cruiseFL"
        },
        {
          "num": "8",
          "title": "Vertical Speed to rejoin assigned altitude",
          "formula": "V/S (ft/min) = 2 × Δ feet",
          "example": "At 6 250 ft instead of 6 000 ft\nV/S = 2 × 250 = 500 ft/min",
          "calcId": "vsRejoin"
        },
        {
          "num": "20",
          "title": "Top of Descent (idle thrust, 3° path)",
          "formula": "TOD (NM) = ΔFL / 3",
          "example": "FL 280 down to 2 000 ft (ΔFL = 260)\nTOD = 260 / 3 = 87 NM",
          "tip": "Also: Altitude × 3 = descent start distance in NM",
          "calcId": "tod"
        },
        {
          "num": "21",
          "title": "R/D required to reach a point",
          "formula": "R/D (ft/min) = Speed Number × Altitude (ft) / Distance (NM)",
          "example": "Descend 17 000 ft in 28 NM, TAS 240 kt\nR/D = 4 × 17 000 / 28 = 2 400 ft/min",
          "calcId": "rdRequired"
        },
        {
          "num": "22",
          "title": "Vertical Speed by Body Attitude (high speed)",
          "formula": "R/D (ft/min) = Mach × 100 × ΔBA (°)",
          "example": "Mach 0.74 → 1° BA = 740 ft/min",
          "calcId": "vsByBaHigh"
        },
        {
          "num": "23",
          "title": "Vertical Speed by Body Attitude (lower speed)",
          "formula": "R/D (ft/min) = Speed Number × ΔBA (°)",
          "example": "TAS 420 kt (SN 7), BA 3° down\nR/D = 7 × 3 = 2 100 ft/min",
          "calcId": "vsByBaLow"
        },
        {
          "num": "24",
          "title": "Distance required for a descent profile",
          "formula": "Distance (NM) = Speed Number × Altitude (1 000 ft) / R/D (ft/min)",
          "example": "23 000 ft at 1 000 ft/min, TAS 300 kt (SN 5)\nDistance = 5 × 23 = 115 NM",
          "calcId": "distForDescent"
        },
        {
          "num": "25",
          "title": "Wind correction for descent distance",
          "formula": "Wind Corr (NM) = 10% for each 40 kt wind component",
          "example": "TOD = 87 NM with 20 kt tailwind\nAdd 5% → 92 NM",
          "calcId": "windCorr"
        },
        {
          "num": "26",
          "title": "R/D to follow a glide %",
          "formula": "R/D (ft/min) = Ground Speed (kt) × Glide %",
          "example": "TAS 350 kt, 20 kt tailwind, 3° (5%) glide\nR/D = 370 × 5 = 1 850 ft/min",
          "calcId": "rdForGlidePct"
        },
        {
          "num": "27",
          "title": "Convert glide degrees to percent",
          "formula": "% = 10 × degrees / 6",
          "example": "ILS 3° glide slope = 30 / 6 = 5%",
          "calcId": "degToPercent"
        },
        {
          "num": "GEN",
          "title": "Rate of Descent (RoD) quick calculation",
          "formula": "RoD = GS / 2 × 10 (= GS × 5)",
          "example": "GS 150 kt → RoD = 750 fpm",
          "calcId": "rodQuick"
        },
        {
          "num": "GEN",
          "title": "Idle descent planning",
          "formula": "Allow 3 NM per 1 000 ft",
          "example": "10 000 ft to lose → plan 30 NM before target",
          "calcId": "idleDescent"
        }
      ]
    },
    {
      "id": "navigation",
      "title": "Navigation & Turns",
      "rules": [
        {
          "num": "12",
          "title": "Drift computation in cruise",
          "formula": "Drift (°) = X-wind (kt) / Mach",
          "example": "M 0.7, X-wind 35 kt\nDrift = 35 / 7 = 5°",
          "calcId": "driftMach"
        },
        {
          "num": "13",
          "title": "Drift computation from TAS",
          "formula": "Drift (°) = X-wind (kt) / Speed Number",
          "example": "TAS 180 kt, X-wind 36 kt\nDrift = 36 / 3 = 12°",
          "calcId": "driftTas"
        },
        {
          "num": "15",
          "title": "Off-Track distance",
          "formula": "Off-Track (NM) = Δ° × Distance to station / 60",
          "example": "9° off track, 11 NM from station\nOff-track = 9 × 11 / 60 = 1.6 NM",
          "calcId": "offTrack"
        },
        {
          "num": "16",
          "title": "Slant distance overhead a DME station",
          "formula": "Each 6 000 ft altitude → 1 NM DME reading",
          "example": "Overhead station at FL 330\nDME reads: 33 000 / 6 000 = 5.5 NM",
          "calcId": "slantDistance"
        },
        {
          "num": "17",
          "title": "Intercepting outbound leg near VOR-DME (Mach 0.7)",
          "formula": "1 NM for each Δ30° of track change",
          "example": "FL 330, ΔTrack = 120°\nStart turn at 2 NM before + 5.5 NM slant = 7.5 NM",
          "calcId": "interceptOutbound"
        },
        {
          "num": "18",
          "title": "Intercept heading when passing station",
          "formula": "Attack (°) = 1/3 × ΔTrack (°)",
          "example": "Inbound on 180 to track 060 outbound\nAttack = 120 / 3 = 40° → Hdg 080",
          "calcId": "interceptHeading"
        },
        {
          "num": "19",
          "title": "Intercept heading when slightly off-track",
          "formula": "Attack (°) = 3 × Off-Track angle (°)",
          "example": "On R-310 instead of R-315 (5° off)\nAttack = 3 × 5 = 15° to rejoin",
          "calcId": "interceptOffTrack"
        },
        {
          "num": "28",
          "title": "Start roll-out from a turn",
          "formula": "ΔHdg to go = Bank (°) / 3",
          "example": "Bank 25°, right turn to Hdg 080\nStart roll-out 8° in advance → at Hdg 072",
          "calcId": "rollout"
        },
        {
          "num": "29",
          "title": "Bank for small heading changes",
          "formula": "Bank (°) = ΔHeading (°)",
          "example": "Hdg North, right to Hdg 007 → take 7° bank",
          "calcId": "bankSmall"
        },
        {
          "num": "30",
          "title": "Bank for rate-one turn",
          "formula": "Bank (°) = (TAS / 10) + (TAS / 20)",
          "example": "TAS 180 kt → Bank = 18 + 9 = 27°",
          "calcId": "bankRateOne"
        },
        {
          "num": "31",
          "title": "Turn diameter of a rate-one turn",
          "formula": "Diameter (NM) = TAS (kt) / 100",
          "example": "TAS 150 kt → Turn Ø = 1.5 NM",
          "calcId": "turnDiameter"
        },
        {
          "num": "32",
          "title": "Outbound timing for a base turn",
          "formula": "Time (min) = 36 / ΔTrack (°)",
          "example": "ILS Rwy 27, teardrop 066 outbound\nTime = 36 / (090 − 066) = 1.5 min",
          "calcId": "baseTurnTime"
        },
        {
          "num": "GEN",
          "title": "Rollout angle (for turns)",
          "formula": "Rollout Angle = Bank Angle / 2",
          "example": "Hdg 090° to 270°, BA = 20°\nRA = 10° → start rollout at 260°",
          "calcId": "rolloutAngle"
        }
      ]
    },
